{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "User preferences and saved git workspace settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "githubUsername": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/userProfile" },
      "description": "User profile document"
    }
  }
}
